@page "/"

@inject NavigationManager NavigationManager

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<div class="content">
    <div class="greeting">Moin!</div>

    <div>
        data-münster.de visualisiert Daten des OpenData-Portals der Stadt Münster.
        Wähle einen der Bereiche unten aus.
    </div>

    <div>
        <div class="topics-label">Bereiche</div>
        <div class="topics-container">
            <div @onclick="OnTrafficClicked" class="traffic">
                Verkehr
            </div>
            <div @onclick="OnPoliticsClicked" class="politics">
                Politik
            </div>
        </div>
    </div>
</div>

@code {
    private void OnTrafficClicked()
    {
        NavigationManager.NavigateTo("traffic");
    }

    private void OnPoliticsClicked()
    {
        NavigationManager.NavigateTo("politics");
    }
}